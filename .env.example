APP_NAME="Chispa Fria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://chispasfrias.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PRODUCT_IMAGES_PATH="/../../public_html/images/products/"
VITE_PRODUCT_IMAGES_PATH="/../../public_html/images/products/"

DOCUMENTS_PDF_PATH="docs/pdfs/"

# --- Tienda (config/tienda.php) ---
# Número de WhatsApp de ventas (solo dígitos, con código de país). Si no se define, se usa este mismo.
# WHATSAPP_NUMERO=5491178886833
# Límite de requests por minuto y por IP: confirmar el pedido y probar códigos de descuento.
# THROTTLE_CHECKOUT_POR_MINUTO=10
# THROTTLE_VALIDAR_CUPON_POR_MINUTO=30

# --- Zona horaria de visualización (config/app.php) ---
# Lo guardado en la base sigue en UTC; esto es solo cómo se muestran y se filtran las fechas.
# APP_DISPLAY_TIMEZONE=America/Argentina/Buenos_Aires

# --- Seeders (solo desarrollo; NUNCA corren en producción) ---
# Administrador inicial que crea UserSeeder. Sin contraseña, se genera una aleatoria y se muestra una vez.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NOMBRE=Admin

# --- Integración con el Sistema Central Rukoz (paquete rukoz/core-client) ---
# Interruptor general del paquete: habilita la comunicación con el Central. Apagado no hace nada.
# En producción TODO esto queda apagado hasta la puesta en marcha.
# RUKOZ_INTEGRACION=false
# RUKOZ_CENTRAL_URL=
# RUKOZ_API_KEY=
# RUKOZ_SECRET=
# Webhook que recibe los eventos del Central: POST <APP_URL>/rukoz/webhook, firmado, sin sesión ni CSRF (lo registra el paquete).
# false si el hosting no puede recibir webhooks (entonces el feed se lee cada minuto en vez de cada 5).
# RUKOZ_WEBHOOK_RECIBE=true

# Interruptores propios de la web, por etapa (config/integracion.php). Todos apagados por defecto.
# 10.1: mandar el catálogo (productos, variantes y combos) al Central, completo (rukoz:sync-catalogo) y al guardar en el admin.
# INTEGRACION_CATALOGO=false
# 10.2: el stock que muestra y valida la tienda es el «Disponible web» del Central; el admin deja de editarlo (solo ítems vinculados).
# Necesita RUKOZ_INTEGRACION=true, el cron de `schedule:run` (webhook + feed + sync horario) y la carga inicial:
# `php artisan chispasfrias:stock-cargar`. NO encender en producción sin INTEGRACION_CHECKOUT (10.3): el checkout todavía
# descuenta stock local y el próximo evento del Central lo pisa.
# INTEGRACION_STOCK=false
# INTEGRACION_CHECKOUT=false
# INTEGRACION_CONFIRMACION=false
